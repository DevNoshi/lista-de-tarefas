{
  "name": "lista-de-tarefas",
  "version": "2.0.0",
  "description": "Lista de tarefas PWA com lembretes via Web Push, mesmo com o navegador fechado.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "keys": "node -e \"import('web-push').then(m => console.log(m.default.generateVAPIDKeys()))\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "web-push": "^3.6.7"
  }
}
