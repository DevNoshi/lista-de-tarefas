# Gere as chaves com:  npm run keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Use um e-mail real (o push da Apple recusa assuntos inválidos)
VAPID_SUBJECT=mailto:voce@seudominio.com

PORT=3000
# Onde ficam db.json (lembretes) e, em dev, as chaves. Em produção aponte para um disco persistente.
DATA_DIR=./data
# Defina como 1 se estiver atrás de proxy (Render, Railway, Nginx...) para o limite por IP funcionar
TRUST_PROXY=
